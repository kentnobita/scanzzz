# Port chạy web Next.js (Mặc định 3000)
PORT=3000

# Clerk Authentication (Nếu có dùng)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key_here
CLERK_SECRET_KEY=your_clerk_secret_key_here

# Chỉ bật tạm thời khi chẩn đoán lỗi Custom API; mặc định tắt để tránh ghi log không cần thiết
DEBUG_CUSTOM_API=0
