# ============================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO BACKEND FASTAPI (KOYEB)
# ============================================================

# Môi trường chạy
ENVIRONMENT=production
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,https://scanzzz.vercel.app,https://*.vercel.app

# 1. Google Gemini AI Key (Dùng cho OCR)
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-3.6-flash

# 2. Neon Serverless PostgreSQL Database URL
# Lấy tại Console Neon: Connection Details -> String -> postgresql://...
DATABASE_URL=postgresql://neondb_owner:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require

# 3. Cloudflare R2 Object Storage (Lưu ảnh/PDF gốc)
# Lấy tại Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_R2_ACCESS_KEY_ID=your_r2_access_key_id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_BUCKET_NAME=scan-phieu-bucket
CLOUDFLARE_R2_PUBLIC_DOMAIN=https://pub-xyz.r2.dev

# 4. Clerk Auth Issuer URL (Xác thực JWT Token từ Frontend)
# Lấy tại Clerk Dashboard -> API Keys -> Issuer URL (https://clerk.your-domain.com hoặc https://your-app.clerk.accounts.dev)
CLERK_ISSUER=https://your-app.clerk.accounts.dev
CLERK_SECRET_KEY=sk_test_...
